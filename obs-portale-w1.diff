diff --git a/observatory/web/src/portaleDeclareAbsence.test.js b/observatory/web/src/portaleDeclareAbsence.test.js
new file mode 100644
index 0000000..cea25e0
--- /dev/null
+++ b/observatory/web/src/portaleDeclareAbsence.test.js
@@ -0,0 +1,20 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = join(dirname(fileURLToPath(import.meta.url)), "components");
+
+test("AssetChassis: partial member fetch dichiara, non mono-NIC silenzioso", () => {
+  const src = readFileSync(join(root, "AssetChassis.vue"), "utf8");
+  assert.ok(src.includes("partialWarning"));
+  assert.ok(src.includes("Vista chassis parziale"));
+  assert.ok(src.includes("Non è un dispositivo mono-NIC"));
+});
+
+test("AssetHabits: direzione assente → n/d in colonna value", () => {
+  const src = readFileSync(join(root, "AssetHabits.vue"), "utf8");
+  assert.ok(src.includes("habits-dir-na"));
+  assert.ok(src.includes('v-else-if="showBars" class="habits-dir-na"'));
+});
